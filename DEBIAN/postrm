#!/bin/bash
set -e
APPID="ttyd-web"
if [ "$1" = "purge" ]; then
    systemctl stop "ttyd-web.service" 2>/dev/null || true
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/ttyd-web /etc/ttyd-web /usr/local/ttyd-web 2>/dev/null || true
    rm -f /etc/systemd/system/ttyd-web.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
